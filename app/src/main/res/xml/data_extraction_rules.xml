<?xml version="1.0" encoding="utf-8"?>
<!-- Progress lives in files/komet.json. It follows the child to a new device; generated sounds in the cache do not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
